# Solaris Server Configuration
SOLARIS_HOST=127.0.0.1
SOLARIS_PORT=41731
SOLARIS_DATA_DIR=.solaris-data

# Required when SOLARIS_HOST is non-loopback (e.g. 0.0.0.0 in Docker)
# SOLARIS_AUTH_TOKEN=replace-with-strong-random-token
# SOLARIS_CORS_ORIGINS=https://studio.example.com
# SOLARIS_ALLOW_EXTERNAL_READS=false
# SOLARIS_STATIC_DIR=/usr/local/share/solaris/studio-web

# OpenRouter BYOK (omit for deterministic local fallback swarm)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SOLARIS_APP_URL=https://solaris.studio
# SOLARIS_OPENROUTER_MODEL=google/gemini-2.5-flash
# SOLARIS_STT_MODEL=openai/gpt-4o-audio-preview

# Optional FFmpeg / FFprobe / Chromium / Whisper Overrides
# Note: Debian Bookworm's apt ffmpeg lacks FFmpeg 8's `whisper` audio filter;
# in Docker, supply OPENROUTER_API_KEY for cloud STT or mount a custom FFmpeg 8 binary.
# SOLARIS_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# SOLARIS_FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# SOLARIS_CHROME_PATH=/usr/bin/chromium
# SOLARIS_CHROME_NO_SANDBOX=false
# SOLARIS_GFX_MAX_FRAMES=180
# SOLARIS_MAX_CONCURRENT_EXPORTS=2
# SOLARIS_WHISPER_MODEL=/path/to/ggml-base.en.bin

# Optional S3 / Cloudflare R2 / MinIO Object Storage
# SOLARIS_STORAGE_BACKEND=s3
# SOLARIS_S3_BUCKET=solaris-media
# SOLARIS_S3_REGION=us-east-1
# Local host MinIO: http://127.0.0.1:9000 | Docker Compose (--profile s3-local): http://minio:9000
# SOLARIS_S3_ENDPOINT=http://127.0.0.1:9000
# SOLARIS_S3_ACCESS_KEY_ID=your-access-key
# SOLARIS_S3_SECRET_ACCESS_KEY=your-secret-key
# SOLARIS_S3_SESSION_TOKEN=optional-sts-session-token
# SOLARIS_S3_PREFIX=studio
# SOLARIS_S3_FORCE_PATH_STYLE=true
# SOLARIS_S3_TIMEOUT_SECS=300
# SOLARIS_S3_CACHE_MAX_BYTES=2147483648
